APP_MODE=local-demo
APP_ORIGIN=http://127.0.0.1:3001
# npm run env:init generates random local database passwords into .env.
POSTGRES_PASSWORD=replace-with-local-secret
DATABASE_URL=postgresql://commerce_app:replace-with-local-app-secret@127.0.0.1:55432/commerce_ai
IDENTITY_DATABASE_URL=postgresql://commerce_identity:replace-with-local-identity-secret@127.0.0.1:55432/commerce_ai
QUEUE_DATABASE_URL=postgresql://commerce_queue:replace-with-local-queue-secret@127.0.0.1:55432/commerce_ai
ADMIN_DATABASE_URL=postgresql://postgres:replace-with-local-secret@127.0.0.1:55432/commerce_ai
AI_ENABLED=false
AI_MODEL=
AI_GATEWAY_API_KEY=
# These are reference rates for estimates, never provider billing facts.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=

APP_MODE=local-demo
APP_ORIGIN=http://127.0.0.1:3001
# Render staging uses APP_MODE=staging-demo, derives APP_ORIGIN from its hostname,
# and requires a private STAGING_DEMO_PASSWORD of at least 16 characters.
# npm run env:init generates random local database passwords into .env.
POSTGRES_PASSWORD=replace-with-local-secret
DATABASE_URL=postgresql://commerce_app:replace-with-local-app-secret@127.0.0.1:55432/commerce_ai
IDENTITY_DATABASE_URL=postgresql://commerce_identity:replace-with-local-identity-secret@127.0.0.1:55432/commerce_ai
QUEUE_DATABASE_URL=postgresql://commerce_queue:replace-with-local-queue-secret@127.0.0.1:55432/commerce_ai
ADMIN_DATABASE_URL=postgresql://postgres:replace-with-local-secret@127.0.0.1:55432/commerce_ai
AI_ENABLED=false
AI_MODEL=
AI_GATEWAY_API_KEY=
# These are reference rates for estimates, never provider billing facts.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
# Local-only HMAC key (32+ characters) for deterministic pseudonyms in redacted statement samples.
DATA_REDACTION_KEY=

# TikTok Shop seller OAuth. Copy the full Seller authorization link from
# Partner Center; it must already contain service_id. Never commit real values.
TIKTOK_SHOP_ENVIRONMENT=development
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_SELLER_AUTH_URL=
# Generate each value independently. OAuth state: 32+ random characters.
# Token key: exactly 32 random bytes encoded as base64.
TIKTOK_SHOP_OAUTH_STATE_SECRET=
TIKTOK_SHOP_TOKEN_ENCRYPTION_KEY=

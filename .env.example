APP_MODE=local-demo
APP_ORIGIN=http://127.0.0.1:3001
# Render staging uses APP_MODE=staging-demo, derives APP_ORIGIN from its hostname,
# and requires a private STAGING_DEMO_PASSWORD of at least 16 characters.
# npm run env:init generates random local database passwords into .env.
POSTGRES_PASSWORD=replace-with-local-secret
DATABASE_URL=postgresql://commerce_app:replace-with-local-app-secret@127.0.0.1:55432/commerce_ai
IDENTITY_DATABASE_URL=postgresql://commerce_identity:replace-with-local-identity-secret@127.0.0.1:55432/commerce_ai
QUEUE_DATABASE_URL=postgresql://commerce_queue:replace-with-local-queue-secret@127.0.0.1:55432/commerce_ai
ADMIN_DATABASE_URL=postgresql://postgres:replace-with-local-secret@127.0.0.1:55432/commerce_ai
AI_ENABLED=false
AI_MODEL=
AI_GATEWAY_API_KEY=
# These are reference rates for estimates, never provider billing facts.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
# Ed25519 PKCS8 private key (base64url DER) used only by Commerce Core to mint
# five-minute tenant/shop-scoped EVE session grants. Never copy it to Vercel.
COMMERCE_AGENT_SESSION_KEY_ID=commerce-agent-session-poc-1
COMMERCE_AGENT_SESSION_PRIVATE_KEY=
# Staging-demo startup receives only a hash/prefix for the synthetic read-only
# principal. The raw svc_ credential belongs only in Vercel Preview.
COMMERCE_AGENT_STAGING_PRINCIPAL_BOOTSTRAP=false
COMMERCE_AGENT_STAGING_CREDENTIAL_HASH=
COMMERCE_AGENT_STAGING_CREDENTIAL_PREFIX=
COMMERCE_AGENT_STAGING_CREDENTIAL_EXPIRES_AT=
# EVE remains disabled unless enabled=true and the kill switch is false.
# Static POC routing also requires the tenant UUID allowlist. Dynamic routing
# reads a dual-approved synthetic tenant policy from Commerce Core instead.
COMMERCE_AGENT_EVE_ENABLED=false
COMMERCE_AGENT_EVE_KILL_SWITCH=true
COMMERCE_AGENT_EVE_TENANT_IDS=
COMMERCE_AGENT_DYNAMIC_ROUTING=false
# Eve live AI stays disabled unless every staging-canary policy value below is
# explicitly supplied in Vercel Preview. Never place the Core signing private
# key, database credentials, marketplace secrets or direct model API keys there.
COMMERCE_AGENT_LIVE_AI=false
COMMERCE_AGENT_CANARY_MODE=
COMMERCE_AGENT_CANARY_APPROVAL_ID=
COMMERCE_AGENT_MODEL_ALLOWLIST=
COMMERCE_AGENT_CANARY_SHOP_IDS=
COMMERCE_AGENT_CANARY_ALLOWED_ROLES=
COMMERCE_AGENT_CANARY_EXPIRES_AT=
COMMERCE_AGENT_MAX_NEW_INPUT_TOKENS=
COMMERCE_AGENT_MAX_OUTPUT_TOKENS=
COMMERCE_AGENT_MAX_COST_USD=
# Local-only HMAC key (32+ characters) for deterministic pseudonyms in redacted statement samples.
DATA_REDACTION_KEY=

# TikTok Shop seller OAuth. Copy the full Seller authorization link from
# Partner Center; it must already contain service_id. Never commit real values.
TIKTOK_SHOP_ENVIRONMENT=development
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_SELLER_AUTH_URL=
# Generate each value independently. OAuth state: 32+ random characters.
# Token key: exactly 32 random bytes encoded as base64.
TIKTOK_SHOP_OAUTH_STATE_SECRET=
TIKTOK_SHOP_TOKEN_ENCRYPTION_KEY=
# Optional synthetic/staging Eve cleanup dispatcher. Keep disabled until the
# corresponding public key is configured on the isolated agent runtime.
COMMERCE_AGENT_CLEANUP_ENABLED=false
COMMERCE_AGENT_EVE_URL=
COMMERCE_AGENT_CLEANUP_KEY_ID=
COMMERCE_AGENT_CLEANUP_PRIVATE_KEY=

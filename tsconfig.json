{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "ES2022"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true,
    "module": "ESNext", "moduleResolution": "Bundler", "resolveJsonModule": true,
    "jsx": "react-jsx", "allowJs": true, "isolatedModules": true,
    "paths": {"@commerce/*": ["./packages/*/src/index.ts"]}
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "apps/web/.next"]
}

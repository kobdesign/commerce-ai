{
  "name": "commerce-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start",
    "env:init": "node scripts/init-env.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "worker": "node --env-file-if-exists=.env --import tsx apps/worker/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages scripts tests --max-warnings 0",
    "test": "node --env-file-if-exists=.env scripts/test.mjs",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "readiness:check": "node --env-file-if-exists=.env --import tsx scripts/check-readiness.ts",
    "release:preflight": "node --env-file-if-exists=.env --import tsx scripts/check-release-configuration.ts",
    "release:decisions": "node --import tsx scripts/check-production-decisions.ts",
    "ops:status": "node --env-file-if-exists=.env --import tsx scripts/operational-controls.ts status",
    "ops:control": "node --env-file-if-exists=.env --import tsx scripts/operational-controls.ts",
    "monitor:once": "node --env-file-if-exists=.env --import tsx scripts/monitor-runtime.ts --once",
    "monitor:start": "node --env-file-if-exists=.env --import tsx scripts/monitor-runtime.ts",
    "ops:rehearse-incident": "node --env-file-if-exists=.env --import tsx scripts/rehearse-incident-controls.ts",
    "eval:finance:readiness": "node --env-file-if-exists=.env --import tsx scripts/financial-review-eval-readiness.ts",
    "data:prepare-statement": "node --env-file-if-exists=.env --import tsx scripts/prepare-settlement-sample.ts",
    "data:verify-statement": "node --env-file-if-exists=.env --import tsx scripts/verify-settlement-sample.ts",
    "data:verify-storage": "node --env-file-if-exists=.env --import tsx scripts/verify-evidence-storage.ts",
    "db:rehearse-restore": "node --env-file-if-exists=.env --import tsx scripts/rehearse-local-restore.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "5.3.0",
    "ai": "7.0.102",
    "csv-parse": "7.0.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "pg-boss": "12.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "9.3.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "agent-browser": "0.27.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
